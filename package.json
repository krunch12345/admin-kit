{
  "name": "admin-kit",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared admin panel UI kit for React apps (auth, shell, MUI UI, locale)",
  "author": "Konstantin Chukreev <krunch12345@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-injection/admin-kit.git"
  },
  "bugs": {
    "url": "https://github.com/code-injection/admin-kit/issues"
  },
  "homepage": "https://github.com/code-injection/admin-kit#readme",
  "keywords": [
    "react",
    "admin",
    "mui",
    "redux-toolkit",
    "rtk-query",
    "admin-panel",
    "ui-kit"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@3.5.1",
  "main": "./dist/admin-kit.js",
  "module": "./dist/admin-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/admin-kit.js",
      "default": "./dist/admin-kit.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js",
      "default": "./dist/shell/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./locale": {
      "types": "./dist/locale/index.d.ts",
      "import": "./dist/locale/index.js",
      "default": "./dist/locale/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src vite.config.ts eslint.config.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "yarn lint && yarn typecheck && yarn test && yarn build"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-date-pickers": "^7.0.0",
    "@reduxjs/toolkit": "^2.2.0",
    "@rpldy/upload-button": "^1.10.0",
    "@rpldy/upload-drop-zone": "^1.10.0",
    "@rpldy/upload-paste": "^1.10.0",
    "@rpldy/upload-preview": "^1.10.0",
    "@rpldy/uploady": "^1.10.0",
    "date-fns": "^2.29.0",
    "lodash-es": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.0",
    "react-image-crop": "^11.0.10",
    "react-redux": "^9.1.0",
    "react-router": "^6.22.0",
    "react-router-dom": "^6.22.0",
    "react-scroll": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@mui/x-date-pickers": {
      "optional": true
    },
    "@rpldy/upload-button": {
      "optional": true
    },
    "@rpldy/upload-drop-zone": {
      "optional": true
    },
    "@rpldy/upload-paste": {
      "optional": true
    },
    "@rpldy/upload-preview": {
      "optional": true
    },
    "@rpldy/uploady": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "react-image-crop": {
      "optional": true
    },
    "react-scroll": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@eslint/js": "^10.0.1",
    "@mui/icons-material": "^5.15.14",
    "@mui/material": "^5.15.14",
    "@mui/x-date-pickers": "^7.6.0",
    "@reduxjs/toolkit": "^2.2.2",
    "@rpldy/upload-button": "^1.10.0",
    "@rpldy/upload-drop-zone": "^1.10.0",
    "@rpldy/upload-paste": "^1.10.0",
    "@rpldy/upload-preview": "^1.10.0",
    "@rpldy/uploady": "^1.10.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/react-scroll": "^1.8.10",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^5.1.0",
    "date-fns": "^2.29.3",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lodash-es": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-image-crop": "^11.0.10",
    "react-redux": "^9.1.0",
    "react-router": "^6.22.3",
    "react-router-dom": "^6.22.3",
    "react-scroll": "^1.9.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "async-mutex": "^0.5.0"
  }
}
